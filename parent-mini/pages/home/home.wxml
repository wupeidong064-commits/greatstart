<view class="home safe">
  <view class="row greeting"><view><text class="eyebrow">成长有迹 · 家校同行</text><view class="hello">{{parentName}}，您好</view></view><button class="text-button" bindtap="logout">退出</button></view>
  <view wx:if="{{loading}}" class="muted">正在同步孩子信息…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="retryStudents">重新加载</button></view>
  <view wx:if="{{child}}">
    <picker mode="selector" range="{{students}}" range-key="name" value="{{selectedIndex}}" bindchange="changeChild"><view class="child-picker row"><view><text class="muted">正在查看</text><view class="child-name">{{child.name}}</view></view><text class="switch">切换孩子</text></view></picker>
    <view class="balance-card"><view class="balance-label">剩余课时</view><view class="balance-value">{{child.remainingText}}<text class="balance-unit"> 节</text></view><view class="balance-footer"><text>已购 {{child.purchasedText}} 节</text><text>已消耗 {{child.consumedText}} 节</text></view></view>
    <view class="tabs"><button class="tab {{tab === 'schedules' ? 'active' : ''}}" data-tab="schedules" bindtap="changeTab">课程安排</button><button class="tab {{tab === 'logs' ? 'active' : ''}}" data-tab="logs" bindtap="changeTab">课时明细</button><button class="tab {{tab === 'notifications' ? 'active' : ''}}" data-tab="notifications" bindtap="changeTab">机构通知</button></view>
    <view wx:if="{{tab === 'schedules'}}" class="card"><view class="section-title">近期课程与变更</view><view class="muted">未来45天，以最新课程安排和机构通知为准</view><view wx:if="{{schedulesState === 'loading'}}" class="empty">正在同步课表…</view><view wx:if="{{schedulesError}}" class="error">{{schedulesError}}<button class="secondary" data-section="schedules" bindtap="retrySection">重试课表</button></view><view wx:if="{{schedulesState === 'ready'}}"><view wx:if="{{!schedules.length}}" class="empty">近期暂无课程安排<view class="muted">如有疑问，请联系机构</view></view></view><view wx:for="{{schedules}}" wx:key="id" class="record"><view class="row"><text class="record-title">{{item.name}}</text><text class="pill {{item.changed ? 'warning' : ''}}">{{item.statusText}}</text></view><view class="schedule-time">{{item.date}}</view><view class="muted">结束 {{item.end}}</view><view class="muted">{{item.venue}} · 老师 {{item.teacherName}}</view><view wx:if="{{item.changed}}" class="change-note">课程安排有变更，请核对机构通知</view></view><button wx:if="{{hasMore}}" class="secondary" loading="{{schedulesState === 'loading'}}" bindtap="moreSchedules">加载更多课程</button></view>
    <view wx:if="{{tab === 'logs'}}" class="card"><view class="section-title">课时变动明细</view><view class="muted">余额以机构账户为准；增加记录可能包含购课、赠课或返还。</view><view wx:if="{{logsState === 'loading'}}" class="empty">正在同步明细…</view><view wx:if="{{logsError}}" class="error">{{logsError}}<button class="secondary" data-section="logs" bindtap="retrySection">重试明细</button></view><view wx:if="{{logsState === 'ready'}}"><view wx:if="{{!logs.length}}" class="empty">暂无课时变动记录</view></view><view wx:for="{{logs}}" wx:key="id" class="record"><view class="row"><text class="record-title">{{item.label}}</text><text class="lesson-value">{{item.value}} 节</text></view><view class="muted">{{item.date}}</view></view><button wx:if="{{logsHasMore}}" class="secondary" data-section="logs" bindtap="moreRecords" loading="{{logsState === 'loading'}}">加载更早明细</button></view>
    <view wx:if="{{tab === 'notifications'}}" class="card"><view class="section-title">机构站内通知</view><view class="muted">打开小程序后同步；微信订阅推送尚未开通。</view><view wx:if="{{notificationsState === 'loading'}}" class="empty">正在同步通知…</view><view wx:if="{{notificationsError}}" class="error">{{notificationsError}}<button class="secondary" data-section="notifications" bindtap="retrySection">重试通知</button></view><view wx:if="{{notificationsState === 'ready'}}"><view wx:if="{{!notifications.length}}" class="empty">暂无机构通知</view></view><view wx:for="{{notifications}}" wx:key="id" class="record"><view class="record-title">{{item.title}}</view><view class="muted">{{item.time}}</view><view class="body-text">{{item.body}}</view></view><button wx:if="{{notificationsHasMore}}" class="secondary" data-section="notifications" bindtap="moreRecords" loading="{{notificationsState === 'loading'}}">加载更早通知</button></view>
  </view>
  <view wx:else=""><view wx:if="{{!loading}}"><view wx:if="{{!error}}" class="card empty">暂未关联孩子<view class="muted">请联系机构核对家长账号的手机号与学员档案。</view><button class="secondary refresh" bindtap="retryStudents">刷新关联信息</button></view></view></view>
  <view class="muted footer">下拉刷新，获取最新信息。</view>
</view>
