page{background:#f4f7f5;color:#172b24;font-size:28rpx;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}view,text,input,button{box-sizing:border-box}button{font-size:28rpx;border-radius:20rpx}button::after{border:0}.primary{background:#176a50;color:#fff}.secondary{background:#e7efe9;color:#245f4b}.text-button{background:transparent;color:#30664f;font-size:25rpx;padding:0 18rpx;margin:0}.muted{color:#687c70;font-size:25rpx;line-height:1.7}.eyebrow{color:#4b7560;font-size:22rpx;letter-spacing:4rpx}.title{font-size:42rpx;font-weight:650;line-height:1.3;margin:12rpx 0 20rpx}.card{background:#fff;border:1rpx solid #e0e8e1;border-radius:28rpx;padding:30rpx;margin-bottom:24rpx}.error{background:#fff1ee;color:#9a402e;padding:24rpx;border-radius:18rpx;line-height:1.6;margin:20rpx 0}.empty{padding:48rpx 16rpx;text-align:center;color:#6c7e71;line-height:1.8}.section-title{font-size:30rpx;font-weight:600;margin-bottom:18rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.record{padding:26rpx 0;border-top:1rpx solid #edf1eb}.record:first-child{border-top:0;padding-top:4rpx}.record-title{font-size:29rpx;font-weight:600;line-height:1.6}.pill{display:inline-block;background:#edf3ec;color:#3c6b50;padding:6rpx 15rpx;border-radius:12rpx;font-size:22rpx}.warning{background:#fff1db;color:#80581f}.body-text{white-space:pre-wrap;line-height:1.8;font-size:27rpx;margin-top:12rpx;overflow-wrap:break-word}.safe{padding-bottom:calc(36rpx + env(safe-area-inset-bottom))}
