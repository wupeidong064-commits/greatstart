# ==================================================
# Buzzer 前端环境变量配置模板
# ==================================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# ==================================================
# API 配置（必需）
# ==================================================
# 后端 API 地址
# 开发环境: http://localhost:3000
# 生产环境: https://api.yourdomain.com
VITE_API_URL=http://localhost:3000

# ==================================================
# MemFire 配置（必需）
# ==================================================
VITE_MEMFIRE_URL=https://your-project.baseapi.memfiredb.com
# 注意：这是匿名密钥，可以暴露在前端
VITE_MEMFIRE_ANON_KEY=your-anon-key-here

# ==================================================
# 测试账号配置（仅用于 E2E 测试）
# ==================================================
# 这些配置仅用于自动化测试，不是真实账号
# 生产环境请删除这些配置
# ADMIN_EMAIL=test-admin@example.com
# ADMIN_PASSWORD=TestPassword123
