# ==================================================
# Buzzer 后端环境变量配置模板
# ==================================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# ==================================================
# MemFire 配置（必需）
# ==================================================
MEMFIRE_URL=https://your-project.baseapi.memfiredb.com
MEMFIRE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==================================================
# 数据库配置（可选，用于 Prisma 直连）
# ==================================================
DATABASE_URL=postgresql://username:password@host:port/database
DATABASE_DIRECT_URL=postgresql://username:password@host:port/database

# ==================================================
# JWT 配置（必需）
# ==================================================
# 生产环境请使用强密码（至少32位随机字符串）
# 生成方式: openssl rand -base64 32
JWT_SECRET=your-strong-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# ==================================================
# 服务器配置
# ==================================================
PORT=3000
NODE_ENV=development

# ==================================================
# CORS 配置（生产环境必需）
# ==================================================
# 允许的前端域名，多个用逗号分隔
# 示例: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:5173

# ==================================================
# 日志配置
# ==================================================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================================================
# 速率限制配置（可选）
# ==================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
